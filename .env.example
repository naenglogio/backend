POSTGRES_USER=naenglog
POSTGRES_PASSWORD=changeme
POSTGRES_DB=naenglog
DATABASE_URL=postgresql+asyncpg://naenglog:changeme@db:5432/naenglog

# Docker Compose pgAdmin 로그인용 (http://localhost:5050). DB 접속 Host는 서비스명 `db`.
PGADMIN_DEFAULT_EMAIL=admin@naenglog.io
PGADMIN_DEFAULT_PASSWORD=changeme

# openssl rand -base64 32 등으로 생성한 임의 문자열을 쓴다. 반드시 환경별로 다른 값을 쓴다.
JWT_SECRET_KEY=changeme
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 비워두면(로컬 기본값) 실제 발송 대신 서버 로그에 인증번호를 남긴다.
# 운영에서는 실제 SMTP 계정 정보로 채운다.
# Gmail은 계정에 2단계 인증을 켠 뒤 "앱 비밀번호"를 발급받아 SMTP_PASSWORD에 쓴다
# (일반 로그인 비밀번호는 동작하지 않는다).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@naenglog.local
SMTP_USE_TLS=true

EMAIL_VERIFICATION_CODE_TTL_MINUTES=5
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_SESSION_TTL_MINUTES=30

APP_NAME=NaengLog API
APP_ENV=local
DEBUG=true
API_PREFIX=/api/v1
LOG_LEVEL=INFO
# 콤마로 구분된 로컬 프런트엔드 origin만 기본 허용한다. production에서는 실제 배포 도메인으로 교체한다.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173